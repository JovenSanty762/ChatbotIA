# Configuración del ChatBot WhatsApp
# Copia este archivo a .env y completa los valores

# ==================
# BASE DE DATOS
# ==================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_chatbot
DB_USER=postgres
DB_PASSWORD=tu_password_postgresql_aqui

# ==================
# WHATSAPP BUSINESS API
# ==================
# Obtén estos valores en https://developers.facebook.com/
WHATSAPP_TOKEN=tu_token_de_acceso_permanente_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
VERIFY_TOKEN=mi_token_verificacion_seguro_123

# ==================
# INTELIGENCIA ARTIFICIAL
# ==================
# Proveedor activo: claude | gemini | groq
AI_PROVIDER=gemini

# Claude (Anthropic) — https://console.anthropic.com/
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui

# Google Gemini (GRATIS) — https://aistudio.google.com/app/apikey
GEMINI_AUTH_TOKEN=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-2.0-flash

# Groq / Llama (GRATIS) — https://console.groq.com/
GROQ_AUTH_TOKEN=tu_api_key_de_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# ── OCR / lectura de documentos ──
# gemini = nube (rápido/preciso, tope diario gratuito) | ollama = local SIN LÍMITE
OCR_PROVIDER=gemini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
OLLAMA_TIMEOUT=120

# ==================
# NGROK
# ==================
# Obtén tu token en https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=tu_token_de_ngrok_aqui
NGROK_ENABLED=true

# Regex (case-insensitive) que identifica hosts PÚBLICOS: cuando el request
# entra por uno de ellos, solo /webhook responde y el panel administrativo
# queda invisible (404 opaco). Ajusta si algún día usas otro tipo de túnel
# o pones el bot detrás de un dominio propio y quieres el mismo blindaje.
PUBLIC_HOST_PATTERN=ngrok|trycloudflare|localtunnel|serveo

# ==================
# SERVIDOR
# ==================
HOST=0.0.0.0
PORT=8000
# Recarga automática al editar código. Solo para desarrollo: en Windows
# DUPLICA el tiempo de arranque. Déjalo en false para que conecte rápido.
RELOAD=false

# ==================
# HOSPITAL
# ==================
HOSPITAL_NOMBRE=Hospital Central
HOSPITAL_DIRECCION=Calle Principal #123, Neiva, Huila
HOSPITAL_TELEFONO=6027374008 o 6027332149

# ==================
# SESIONES
# ==================
SESSION_TIMEOUT_MINUTES=10

# ==================
# SEGURIDAD
# ==================
# Contraseña que protege el botón "Reiniciar sistema" del panel web.
ADMIN_RESET_PASSWORD=cambia_esta_password

# ── Login del panel administrativo (/admin) ─────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave-ahora
# Clave para firmar las cookies de sesión. GENERA UNA ALEATORIA:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA-esta-clave-por-una-larga-y-aleatoria
ADMIN_SESSION_HORAS=8
# En producción (HTTPS detrás de Nginx) pon COOKIE_SECURE=true.
COOKIE_SECURE=false
